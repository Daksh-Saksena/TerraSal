# ==============================================================================
# TerraSal Backend - Environment Variables Configuration
# ==============================================================================

# Server Port (local development only; managed automatically in Vercel)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Database Configuration (Turso / libSQL)
# Required for persistent production storage on Vercel.
# Obtain by running:
#   1. turso db create terrasal
#   2. turso db show terrasal --url
#   3. turso db tokens create terrasal
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Weather Service (OpenWeatherMap API Key)
# Optional: If omitted, TerraSal automatically uses realistic climatological simulation data.
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins, or '*' for public access.
# Example: https://terrasal.vercel.app,http://localhost:5173
CORS_ORIGIN=https://terrasal.vercel.app

# Vercel Cron Secret (Optional)
# Verifies scheduled cron trigger for /api/cron/weather.
# Automatically supplied by Vercel if configured.
CRON_SECRET=your-cron-secret-here
