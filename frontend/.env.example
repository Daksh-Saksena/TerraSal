# ==============================================================================
# TerraSal Frontend - Environment Variables Configuration
# ==============================================================================

# Backend API Base URL
# In local development:
#   Leave empty to automatically use Vite's dev proxy (http://localhost:3000)
# In production on Vercel:
#   Set to the URL of your deployed TerraSal backend project:
#   Example: https://terrasal-backend.vercel.app
VITE_API_URL=https://your-backend-project.vercel.app
